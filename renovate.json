{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>NotCybot/renovate-config"],
  "bumpVersions": [
    {
      "description": "A new image is a new chart release",
      "filePatterns": ["{{packageFileDir}}/Chart.yaml"],
      "matchStrings": ["version:\\s(?<version>[^\\s]+)"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep appVersion in line with the image tag in values.yaml",
      "managerFilePatterns": ["/^charts/[^/]+/Chart\\.yaml$/"],
      "matchStrings": [
        "appVersion: \"?(?<currentValue>[^\"\\s]+)\"? # renovate: image=(?<depName>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
